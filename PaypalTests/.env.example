PAYINREFBASEURL=https://pay-in-staging.app-stg.mukuru.io
KEYCLOAKURL=https://keycloak-staging.app-stg.mukuru.io/realms/mukuru/protocol/openid-connect/token
CLIENTID=your-client-id
CLIENTSECRET=your-client-secret
SCOPE=your-scope
PAYINREFCLIENTID=your-payin-ref-client-id
PAYINREFCLIENTSECRET=your-payin-ref-client-secret

# Optional: wallet-link endpoint can require a different OAuth audience/scope.
