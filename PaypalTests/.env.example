# Copy this file to .env and fill in the values.
# These should be configured as CI/CD variables in GitLab (Settings > CI/CD > Variables).
# NEVER commit the real .env file — it is in .gitignore.

BASEURL=
PAYINREFBASEURL=
KEYCLOAKURL=
CLIENTID=your-client-id
CLIENTSECRET=your-client-secret
SCOPE=your-scope
PAYINREFCLIENTID=your-payin-ref-client-id
PAYINREFCLIENTSECRET=your-payin-ref-client-secret

# Optional: wallet-link endpoint can require a different OAuth audience/scope.
WALLETLINKCLIENTID=optional-wallet-link-client-id
WALLETLINKCLIENTSECRET=optional-wallet-link-client-secret
WALLETLINKSCOPE=optional-wallet-link-scope

# Optional: full token or full 'Bearer ...' header from a known-good curl call.
WALLETLINK_AUTHORIZATION=
GRANTTYPE=client_credentials
RETURNURL=
PAYPAL_USERINFO_CUSTOMER_ID=
